# RCKTDMG — variables de entorno.
# Este archivo es solo una plantilla: NUNCA contiene valores reales.

# ---------- BASE DE DATOS ----------
DATABASE_URL=

# ---------- SESIÓN ----------
AUTH_SECRET=
APP_URL=

# ---------- PAGOS ----------
# Mientras estas variables estén vacías no hay pasarela
# conectada: el webhook rechaza todos los eventos (503) y
# ningún pedido puede llegar a PAID.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
# Obligatoria para aceptar webhooks de pago. Sin ella el
# endpoint queda cerrado a propósito.
CULQI_WEBHOOK_SECRET=

# ---------- ALMACENAMIENTO ----------
# "local" usa el disco (desarrollo). "blob" usa Vercel Blob.
# Si se deja vacío: local en desarrollo, blob en producción.
STORAGE_DRIVER=
# El navegador necesita saber si sube directo al almacén.
NEXT_PUBLIC_STORAGE_DRIVER=

# Token del almacén público "rcktdmg-media"
# (imágenes de producto, avatares y portadas).
# Es el nombre que genera Vercel por defecto.
BLOB_READ_WRITE_TOKEN=

# Token del almacén privado "rcktdmg-files"
# (archivos vendibles). NUNCA se expone al navegador.
BLOB_FILES_READ_WRITE_TOKEN=

# Opcional: host exacto del almacén público para fijar
# remotePatterns en next.config.ts.
# Ejemplo de forma: <id-del-store>.public.blob.vercel-storage.com
BLOB_PUBLIC_HOSTNAME=
