generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(CLIENT)
  creatorStatus CreatorStatus?
  username      String?        @unique
  avatarUrl     String?
  coverUrl      String?
  bio           String?
  publicName    String?
  websiteUrl    String?
  instagramUrl  String?
  facebookUrl   String?
  tiktokUrl     String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  collections    Collection[]
  paymentMethods CreatorPaymentMethod[]
  downloads      Download[]
  favorites      Favorite[]
  orders         Order[]
  products       Product[]              @relation("CreatorProducts")
  subscriptions  Subscription[]
  withdrawals    Withdrawal[]

  /// Creadores a los que sigue este usuario.
  siguiendo  Follow[] @relation("UsuarioSigue")
  /// Usuarios que siguen a este creador.
  seguidores Follow[] @relation("CreadorSeguido")

  notifications Notification[]
  reviews       Review[]
  licenses      License[]
  packs         Pack[]         @relation("CreatorPacks")

  /// Solicitudes que ha enviado para ser creador.
  solicitudes          CreatorApplication[] @relation("SolicitudesCreador")
  /// Solicitudes que ha revisado, si es administrador.
  solicitudesRevisadas CreatorApplication[] @relation("SolicitudesRevisadas")

  coleccionesComerciales CommercialCollection[] @relation("CreatorCollections")
}

/**
 * Licencia de uso de un recurso comprado.
 * Es el documento que acredita QUÉ puede hacer una persona
 * con un recurso, y se puede verificar después: guarda a quién
 * se otorgó, sobre qué recurso, qué compra la originó, con qué
 * condiciones y cuándo.
 * Nace de una línea de pedido, no del pedido entero: un pedido
 * con tres recursos otorga tres licencias, porque cada recurso
 * puede tener condiciones distintas.
 * `type` y `terms` se COPIAN en el momento de otorgarla. Si el
 * creador cambia mañana la licencia de su recurso, quien ya
 * compró conserva las condiciones que aceptó: una licencia que
 * se reescribe sola no acredita nada.
 */
model License {
  id String @id @default(cuid())

  /// Código legible para soporte. Se deriva de la línea de
  /// compra, así que es estable y no depende del azar.
  code String @unique

  userId      String
  productId   String
  orderId     String
  /// La línea de compra exacta. Única: una licencia por línea,
  /// lo que hace idempotentes los reintentos del webhook sin
  /// necesidad de comprobarlo en código.
  orderItemId String @unique

  type   LicenseType
  status LicenseStatus @default(ACTIVE)

  /// Condiciones vigentes al otorgarla, copiadas tal cual.
  terms String?

  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  /// Por qué se retiró. Visible para su titular.
  revokedReason String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// "Mis licencias", de la más reciente a la más antigua.
  @@index([userId, grantedAt])
  /// Comprobación al descargar: ¿tiene licencia vigente?
  @@index([userId, productId, status])
  /// Sincronizar todas las de un pedido al cambiar de estado.
  @@index([orderId])
}

/**
 * Un pack: varios recursos que se venden juntos.
 * NO es un producto con una etiqueta. Es una agrupación con
 * nombre, portada y precio propios, que al comprarse otorga
 * acceso a CADA recurso incluido por separado: su descarga y
 * su licencia individuales.
 * Convive con los productos que hoy llevan la etiqueta "pack".
 * Esos siguen siendo productos normales y no se tocan.
 */
model Pack {
  id          String     @id @default(cuid())
  creatorId   String
  name        String
  slug        String     @unique
  description String
  coverUrl    String?
  /**
   * Precio propio, NO la suma de los recursos. El creador lo
   * decide: un pack existe justamente para costar menos que
   * comprar sus piezas sueltas, y calcularlo automáticamente
   * le quitaría esa decisión.
   */
  price       Decimal    @db.Decimal(10, 2)
  status      PackStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  creator    User        @relation("CreatorPacks", fields: [creatorId], references: [id], onDelete: Cascade)
  items      PackItem[]
  /// Líneas de pedido originadas por la compra de este pack.
  orderItems OrderItem[]

  @@index([creatorId])
  @@index([status])
}

model PackItem {
  packId    String
  productId String
  /// Orden en que se presentan dentro del pack.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  pack    Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Un recurso no puede estar dos veces en el mismo pack.
  @@id([packId, productId])
  @@index([productId])
}

/**
 * Estado de un pack.
 * Sin revisión administrativa, y es deliberado: un pack solo
 * puede contener recursos que YA pasaron por PENDING_REVIEW y
 * están publicados. Lo que se revisa —los archivos— ya está
 * revisado; añadir una segunda cola para el nombre y la
 * portada sería duplicar el flujo sin añadir control real.
 * Administración conserva la potestad de archivarlo.
 */
enum PackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * Una versión publicada de un recurso.
 * Cada versión guarda SU PROPIO archivo. Los archivos de las
 * versiones anteriores NO se borran: siguen siendo el objeto
 * que compró quien compró entonces, y borrarlos convertiría el
 * historial en una lista de enlaces rotos.
 * `fileUrl` es una referencia al almacén privado. Nunca sale
 * hacia el navegador: la descarga la sirve
 * /api/downloads/[id] después de comprobar sesión, pedido
 * pagado y licencia vigente.
 */
model ProductVersion {
  id        String @id @default(cuid())
  productId String

  /// Número tal y como lo escribió el creador: "1.0", "2.1.3".
  version String

  /// Archivo privado de ESTA versión.
  fileUrl    String
  fileFormat String?

  /// Qué cambió respecto a la anterior.
  changelog String?

  /// Solo una por recurso puede ser la vigente.
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads Download[]

  /// Dos versiones del mismo recurso no pueden llamarse igual.
  @@unique([productId, version])
  /// "¿cuál es la vigente de este recurso?"
  @@index([productId, isCurrent])
}

enum LicenseType {
  /// Uso personal, sin explotación comercial.
  PERSONAL
  /// Uso comercial por cuenta propia o de un cliente.
  COMMERCIAL
  /// Uso comercial ampliado, incluido el uso corporativo.
  ENTERPRISE
}

enum LicenseStatus {
  /// Vigente.
  ACTIVE
  /// Retirada: el pedido se canceló o se reembolsó.
  REVOKED
}

/**
 * Valoración de un recurso.
 * Solo puede escribirla quien tiene acceso legítimo al
 * recurso: lo decide `puedeValorar` en src/lib/resenas.ts, y
 * se comprueba en el servidor cada vez, no solo al pintar el
 * formulario.
 * La clave única por (usuario, recurso) impide dos reseñas de
 * la misma persona sobre el mismo recurso sin depender de que
 * el código lo compruebe. Editar actualiza la fila existente.
 */
model Review {
  id             String       @id @default(cuid())
  userId         String
  productId      String
  /// De 1 a 5. Se valida antes de escribir.
  rating         Int
  comment        String?
  status         ReviewStatus @default(PUBLISHED)
  /// Motivo interno al ocultarla. No se muestra en público.
  moderationNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Una reseña por persona y recurso.
  @@unique([userId, productId])
  /// Listado público de un recurso: solo las publicadas.
  @@index([productId, status, createdAt])
  /// Cola de moderación y "mis reseñas".
  @@index([status, createdAt])
  @@index([userId])
}

enum ReviewStatus {
  /// Visible en la ficha del recurso.
  PUBLISHED
  /// Retirada por administración. No suma a la media.
  HIDDEN
}

/**
 * Notificación de un usuario.
 * Se escribe cuando ocurre el hecho, no cuando alguien abre
 * la campana: por eso el estado leído sobrevive al cambio de
 * navegador o de dispositivo, que antes no ocurría porque
 * vivía en localStorage.
 * `title` y `body` se guardan ya redactados. Es deliberado:
 * una notificación cuenta lo que pasó EN SU MOMENTO, y si más
 * tarde el recurso cambia de nombre o el pedido de importe,
 * el aviso no debe reescribirse solo.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /// Ruta interna al recurso relacionado, si la hay.
  href      String?
  /// null mientras está sin leer.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Contador de no leídas: el caso más frecuente con mucho.
  @@index([userId, readAt])
  /// Listado paginado, siempre del más reciente al más antiguo.
  @@index([userId, createdAt])
}

/**
 * Tipos de notificación.
 * Cubren uno a uno los avisos que el centro de notificaciones
 * ya mostraba derivándolos de otras tablas. Es un enum y no un
 * texto libre para que añadir un tipo nuevo obligue a decidir
 * también su icono y su tono.
 */
enum NotificationType {
  /// ADMIN · un creador envió un recurso a revisión.
  PRODUCT_SUBMITTED
  /// CREADOR · su recurso fue publicado.
  PRODUCT_PUBLISHED
  /// CREADOR · su recurso fue rechazado.
  PRODUCT_REJECTED
  /// CREADOR · alguien compró uno de sus recursos.
  SALE
  /// CREADOR · alguien guardó uno de sus recursos.
  FAVORITE
  /// CREADOR · alguien empezó a seguirle.
  FOLLOW
  /// CREADOR · alguien valoró uno de sus recursos.
  REVIEW
  /// CLIENTE · su reseña fue retirada por moderación.
  REVIEW_HIDDEN
  /// CLIENTE · su licencia dejó de estar vigente.
  LICENSE_REVOKED
  /// CLIENTE · un recurso que compró tiene una versión nueva.
  PRODUCT_VERSION
  /// SEGUIDOR · un creador al que sigue publicó un pack.
  PACK_PUBLISHED
  /// SEGUIDOR · un creador al que sigue publicó una colección.
  COLLECTION_PUBLISHED
  /// ADMIN · alguien pidió ser creador.
  CREATOR_APPLICATION_SUBMITTED
  /// CLIENTE · su solicitud de creador fue aprobada.
  CREATOR_APPLICATION_APPROVED
  /// CLIENTE · su solicitud de creador fue rechazada.
  CREATOR_APPLICATION_REJECTED
  /// ADMIN · un creador solicitó un retiro.
  WITHDRAWAL_REQUESTED
  /// CREADOR · su retiro cambió de estado.
  WITHDRAWAL_UPDATED
  /// CLIENTE y ADMIN · un pedido quedó pagado.
  ORDER_PAID
  /// CLIENTE · su pedido se canceló o se reembolsó.
  ORDER_UPDATED
  /// CLIENTE · ya puede descargar lo que compró.
  DOWNLOAD_READY
  /// ADMIN · se registró un usuario o un creador.
  USER_REGISTERED
  /// Aviso de la plataforma, sin origen en otra tabla.
  SYSTEM
}

/**
 * Un usuario sigue a un creador.
 * Las dos puntas son User porque un creador es un usuario con
 * rol CREATOR: no hay tabla de creadores aparte. La clave
 * primaria compuesta impide seguir dos veces a la misma
 * persona sin necesidad de comprobarlo en código.
 */
model Follow {
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User @relation("UsuarioSigue", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("CreadorSeguido", fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  /// "¿cuántos seguidores tiene?" y el listado del creador.
  @@index([creatorId, createdAt])
  /// "¿a quién sigo?", para el área del cliente.
  @@index([followerId, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  /**
   * Portada de la categoría.
   * Pública: se enseña en la tienda y en la portada del sitio,
   * así que vive en el almacén público. La sube administración
   * a mano; NO se deduce del primer recurso que contenga,
   * porque entonces la imagen de la sección cambiaría sola
   * cada vez que alguien publica algo.
   */
  coverUrl    String?
  /**
   * Una categoría retirada deja de ofrecerse a los creadores y
   * de aparecer en la navegación, pero NO se borra: sus
   * recursos siguen existiendo y siguen teniendo categoría.
   * Borrarla dejaría productos huérfanos.
   */
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  solicitudes CreatorApplicationCategory[]

  /// Búsqueda por similitud sobre el nombre de la categoría.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  /// Solo informativo: ordena el listado del panel de admin.
  createdAt DateTime @default(now())

  products ProductTag[]

  /// Búsqueda por similitud sobre el nombre de la etiqueta.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Product {
  id          String        @id @default(cuid())
  creatorId   String
  categoryId  String
  name        String
  slug        String        @unique
  description String
  price       Decimal       @db.Decimal(10, 2)
  accessType  AccessType    @default(BOTH)
  status      ProductStatus @default(DRAFT)
  coverUrl    String?
  previewUrl  String?
  /**
   * Archivo vigente del recurso.
   * Desde que existen las versiones, este campo es un ESPEJO
   * del archivo de la versión actual, no una fuente propia. Se
   * conserva a propósito: lo leen la ficha pública, el panel
   * del creador, el de administración y el envío a revisión, y
   * quitarlo obligaría a tocar todos esos sitios a la vez.
   * Un recurso sin versiones —los que ya existían— sigue
   * funcionando exactamente igual que antes: este es su único
   * archivo.
   */
  fileUrl     String?
  /// Extensión real del archivo, calculada al subirlo. Nunca se escribe a mano.
  fileFormat  String?

  /**
   * Dimensiones reales de la PORTADA, leídas de su cabecera al
   * subirla. Nulas si no se pudieron leer.
   * Van aquí y no en ProductImage porque la portada es un
   * campo del recurso, no una fila de la galería, y es la
   * imagen que se enseña en las tarjetas, en las Stories y en
   * el carrusel de Corporativos. Sin su tamaño no se puede
   * filtrar por formato real ni respetar su proporción.
   */
  coverWidth      Int?
  coverHeight     Int?
  /// Color dominante declarado por el creador. Null si no lo indicó.
  color           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rejectionReason String?

  /**
   * Valoración media y número de reseñas PUBLICADAS.
   * Están desnormalizadas a propósito: ordenar el catálogo por
   * valoración o pintar las estrellas en cada tarjeta exigiría
   * agregar reseñas en cada carga de la tienda. Se recalculan
   * dentro de la misma transacción que escribe la reseña, en
   * src/lib/resenas.ts, que es el único sitio que las toca.
   */
  avgRating   Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0)

  /**
   * Licencia con la que se vende este recurso.
   * PERSONAL por defecto, que es lo más restrictivo: los ocho
   * recursos que ya existen se venden bajo esas condiciones y
   * nadie ha declarado otra cosa. Poner por defecto algo más
   * permisivo les concedería derechos que su creador nunca
   * otorgó.
   */
  licenseType LicenseType @default(PERSONAL)

  /**
   * Qué pieza es, dentro de un evento.
   *
   * NULL a propósito, y para siempre: los recursos anteriores
   * a esta etapa nunca declararon su tipo y no se les va a
   * inventar uno. Null significa «no se declaró», que es
   * distinto de «es otra cosa» (EVENT_OTHER, que sí es una
   * elección del creador).
   *
   * Lo elige QUIEN PUBLICA y no se deduce de las medidas: un
   * flyer de 1080 × 1920 sigue siendo un flyer. Las medidas
   * sirven para comprobar el tipo declarado, nunca para
   * cambiarlo.
   *
   * Solo lo usan las piezas de la categoría «eventos». En las
   * demás queda null.
   */
  pieceType PieceType?

  collectionItems CollectionItem[]
  downloads       Download[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  reviews         Review[]
  licenses        License[]
  versions        ProductVersion[]
  packItems       PackItem[]
  coleccionItems  CommercialCollectionItem[]

  category Category @relation(fields: [categoryId], references: [id])
  creator  User     @relation("CreatorProducts", fields: [creatorId], references: [id])

  tags   ProductTag[]
  images ProductImage[]

  @@index([creatorId])
  @@index([categoryId])
  @@index([status])
  @@index([fileFormat])
  @@index([color])
  /**
   * Búsqueda por similitud (pg_trgm). Un GIN con gin_trgm_ops
   * es lo único que permite a Postgres usar un índice para
   * `ILIKE '%texto%'`: sin él, cada búsqueda recorre la tabla
   * entera.
   */
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  /**
   * La clave primaria solo indexa (productId, tagId), así que
   * "qué recursos tienen esta etiqueta" no podía usar índice.
   */
  @@index([tagId])
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  yearlyPrice   Decimal  @db.Decimal(10, 2)
  downloadLimit Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String
  planId        String
  billingPeriod BillingPeriod
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  expiresAt     DateTime
  autoRenew     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  plan Plan @relation(fields: [planId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  subtotal  Decimal     @db.Decimal(10, 2)
  discount  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  downloads Download[]
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payment   Payment?
  licenses  License[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  price          Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  commissionRate Decimal  @default(20) @db.Decimal(5, 2)
  creatorAmount  Decimal  @default(0) @db.Decimal(10, 2)
  platformFee    Decimal  @default(0) @db.Decimal(10, 2)

  /**
   * Pack del que salió esta línea, si vino de uno.
   * Null en las compras individuales, que son todas las que
   * existen hoy. Comprar un pack NO crea una línea "pack":
   * crea una línea por recurso incluido, cada una con su
   * parte del precio, para que descargas, licencias y
   * ganancias del creador sigan funcionando sin cambios.
   */
  packId String?

  /**
   * Colección comercial de la que salió esta línea, con el
   * mismo criterio que `packId`: comprar una colección NO crea
   * una línea "colección", crea una línea por recurso incluido
   * con su parte del precio, para que descargas, licencias y
   * ganancias del creador sigan funcionando sin cambios.
   */
  commercialCollectionId String?

  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product               @relation(fields: [productId], references: [id])
  pack       Pack?                 @relation(fields: [packId], references: [id])
  collection CommercialCollection? @relation(fields: [commercialCollectionId], references: [id])
  license    License?

  @@index([orderId])
  @@index([productId])
  @@index([packId])
  @@index([commercialCollectionId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  provider      String
  transactionId String?
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Withdrawal {
  id              String           @id @default(cuid())
  creatorId       String
  amount          Decimal          @db.Decimal(10, 2)
  status          WithdrawalStatus @default(REQUESTED)
  note            String?
  createdAt       DateTime         @default(now())
  processedAt     DateTime?
  paymentMethodId String?

  creator       User                  @relation(fields: [creatorId], references: [id])
  paymentMethod CreatorPaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([creatorId])
  @@index([status])
  @@index([paymentMethodId])
}

model Download {
  id            String         @id @default(cuid())
  userId        String
  productId     String
  orderId       String
  downloadCount Int            @default(0)
  status        DownloadStatus @default(ACTIVE)
  expiresAt     DateTime?

  /**
   * Versión que estaba vigente cuando se compró.
   * OPCIONAL a propósito. Las descargas anteriores a esta etapa
   * tienen null, y deben seguir funcionando: null significa
   * "se compró cuando el recurso no tenía versiones".
   * Es un registro histórico, NO lo que se entrega: no se
   * reescribe cuando aparece una versión nueva. Sirve para
   * poder decirle al comprador "compraste la 1.0, ahora hay
   * una 2.0".
   */
  versionId String?

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
  version ProductVersion? @relation(fields: [versionId], references: [id])

  @@unique([userId, productId, orderId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([versionId])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Privada por defecto: nada se publica sin acción explícita.
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([isPublic])
}

model CollectionItem {
  collectionId String
  productId    String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model CreatorPaymentMethod {
  id             String            @id @default(cuid())
  creatorId      String
  type           PaymentMethodType
  holderName     String
  documentNumber String
  bankName       String?
  accountNumber  String?
  cci            String?
  phone          String?
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@index([creatorId])
  @@index([type])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /**
   * Dimensiones REALES del archivo, leídas de su cabecera al
   * subirlo. Nulas cuando no se pudieron leer: nunca se
   * suponen ni se rellenan con un valor "típico".
   * Sirven para dos cosas concretas. Una, enseñar cada imagen
   * con su proporción en lugar de recortarla a una forma fija.
   * Dos, poder filtrar por formato de verdad —la sección de
   * Corporativos pide 1080 × 1350— sin fiarse del nombre del
   * archivo ni de si la imagen es más alta que ancha.
   */
  imageWidth  Int?
  imageHeight Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

enum UserRole {
  ADMIN
  CREATOR
  CLIENT
}

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

/**
 * Pieza de un evento.
 *
 * Los valores llevan el prefijo EVENT_ porque hoy solo se
 * aplican a esa categoría. Si mañana otra necesita sus propios
 * tipos, se añaden con su prefijo y estos no estorban.
 *
 * Cada valor se corresponde con una opción del formulario; la
 * traducción vive en src/lib/tipos-publicacion.ts, que es
 * donde ya estaban las opciones.
 */
enum PieceType {
  EVENT_STORY
  EVENT_FLYER
  EVENT_COVER
  EVENT_PROFILE
  EVENT_POST
  EVENT_OTHER
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AccessType {
  INDIVIDUAL
  PLAN
  BOTH
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
}

enum DownloadStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentMethodType {
  BANK
  YAPE
  PLIN
}

/**
 * ══════════════════════════════════════════════════════════
 * SOLICITUDES PARA SER CREADOR
 * ══════════════════════════════════════════════════════════
 */

/**
 * Solicitud de un cliente para convertirse en creador.
 * Existe como tabla propia y no como campos sueltos en `User`
 * porque guarda algo distinto de lo que es el usuario hoy: lo
 * que PIDIÓ ser, cuándo, con qué portafolio y qué contestó
 * administración. `User.creatorStatus` sigue siendo la verdad
 * sobre el estado actual; esto es el expediente.
 * El portafolio es obligatorio: sin una muestra de trabajo no
 * hay nada que revisar.
 */
model CreatorApplication {
  id     String @id @default(cuid())
  userId String

  /// Nombre con el que quiere aparecer en la tienda.
  publicName String
  /// Nombre de usuario solicitado. Se comprueba libre al enviar y al aprobar.
  username   String
  bio        String
  /// En qué se especializa, con sus palabras.
  specialty  String

  /**
   * Trayectoria: años trabajando, clientes, estudios. Opcional
   * porque hay creadores que empiezan, y exigirla dejaría
   * fuera justo a quien más necesita una oportunidad.
   */
  experience String?

  /**
   * Cómo quiere verse en su perfil público.
   * Se piden EN LA SOLICITUD y no después: administración
   * juzga la candidatura entera, y un perfil sin cara ni
   * portada no se puede valorar. Al aprobar se copian al
   * usuario.
   */
  avatarUrl String?
  coverUrl  String?

  /// Qué es el portafolio y qué se está mirando, con sus palabras.
  portfolioDescription String?

  /**
   * Portafolio. Al menos uno de los dos es obligatorio y el
   * servidor lo exige.
   * `portfolioUrl` es un enlace público que el propio
   * solicitante comparte. `portfolioFileUrl` apunta al almacén
   * PRIVADO: solo administración puede abrirlo, y nunca se
   * publica en ninguna página.
   */
  portfolioUrl     String?
  portfolioFileUrl String?

  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  /// Behance, Dribbble, YouTube… una sola, la que quiera añadir.
  otherUrl     String?

  status CreatorApplicationStatus @default(PENDING)

  /// Motivo del rechazo. Obligatorio al rechazar, nunca público.
  rejectionReason String?

  /// Quién la revisó y cuándo. Null mientras está pendiente.
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation("SolicitudesCreador", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SolicitudesRevisadas", fields: [reviewedById], references: [id])

  /// Categorías en las que dice que va a publicar.
  categories CreatorApplicationCategory[]

  /// Trabajos presentados, en el orden que eligió el candidato.
  portfolioItems CreatorPortfolioItem[]

  /// Cola de administración: pendientes primero, por antigüedad.
  @@index([status, createdAt])
  @@index([userId, status])
}

/**
 * Categoría declarada en una solicitud.
 * Apunta a una categoría REAL del catálogo: nadie inventa
 * categorías desde el formulario.
 */
model CreatorApplicationCategory {
  applicationId String
  categoryId    String

  application CreatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([applicationId, categoryId])
  @@index([categoryId])
}

/**
 * Un trabajo del portafolio.
 *
 * Convive con `portfolioUrl` y `portfolioFileUrl`, que siguen
 * siendo válidos: las solicitudes anteriores a esta etapa solo
 * tienen aquellos dos campos y deben seguir viéndose igual.
 * Esto es la forma nueva de presentar varios trabajos, no su
 * sustituto.
 *
 * `imageUrl` apunta al almacén PÚBLICO: son piezas que el
 * candidato quiere enseñar. El archivo privado sigue siendo
 * `portfolioFileUrl`, que solo abre administración.
 */
model CreatorPortfolioItem {
  id            String @id @default(cuid())
  applicationId String

  title       String
  description String?
  /// Imagen de la pieza. Al menos esto o `linkUrl`.
  imageUrl    String?
  /// Enlace al trabajo publicado, si vive en otro sitio.
  linkUrl     String?

  /// Orden en que el candidato quiere que se vean.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  application CreatorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, sortOrder])
}

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * ══════════════════════════════════════════════════════════
 * COLECCIONES COMERCIALES
 * ══════════════════════════════════════════════════════════
 */

/**
 * Colección comercial: un conjunto de recursos que se vende
 * como una sola compra.
 * NO es el modelo `Collection`. Aquella es la lista personal
 * que cualquiera guarda para sí; esta la crea un creador, se
 * publica, tiene precio y se cobra. Compartir tabla habría
 * mezclado una lista privada de favoritos con un artículo del
 * catálogo.
 * Es hermana de `Pack` y sigue su misma arquitectura, con una
 * diferencia deliberada: una colección exige un mínimo de
 * recursos para publicarse (ver MINIMO_RECURSOS_COLECCION).
 */
model CommercialCollection {
  id          String  @id @default(cuid())
  creatorId   String
  name        String
  slug        String  @unique
  description String
  coverUrl    String?

  /**
   * Imagen que enseña QUÉ hay dentro, con marca de agua.
   * No es la portada: la portada es el cartel de la colección
   * en la tienda, y esta es la muestra del contenido. Nula
   * mientras el creador no la suba.
   */
  previewUrl String?

  /**
   * Archivo único de la colección, privado.
   * Opcional a propósito: sin él la compra sigue entregando
   * cada recurso por separado con su descarga y su licencia,
   * que es como funcionaba desde el principio. Con él, además,
   * se puede bajar todo de una vez.
   */
  zipUrl String?

  /// Motivo del rechazo. Solo lo escribe administración.
  rejectionReason String?

  /**
   * Precio propio, NO la suma de los recursos. Lo decide el
   * creador: una colección existe justamente para costar menos
   * que comprar sus piezas sueltas.
   */
  price  Decimal                    @db.Decimal(10, 2)
  status CommercialCollectionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator    User                       @relation("CreatorCollections", fields: [creatorId], references: [id], onDelete: Cascade)
  items      CommercialCollectionItem[]
  /// Líneas de pedido originadas por la compra de esta colección.
  orderItems OrderItem[]

  @@index([creatorId])
  @@index([status])
}

model CommercialCollectionItem {
  collectionId String
  productId    String
  /// Orden en que se presentan dentro de la colección.
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection CommercialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Un recurso no puede estar dos veces en la misma colección.
  @@id([collectionId, productId])
  @@index([productId])
}

/**
 * Estado de una colección comercial.
 *
 * Pasa por la misma cola que un recurso: el creador la deja en
 * DRAFT, la envía a revisión y administración la publica o la
 * rechaza con un motivo. Sus piezas ya pasaron por moderación,
 * pero la colección tiene precio, nombre, portada y descripción
 * propios, y eso no lo ha revisado nadie.
 *
 * Las colecciones anteriores a esta etapa siguen en DRAFT,
 * PUBLISHED o ARCHIVED sin tocarse: los estados nuevos se
 * añaden, no sustituyen a ninguno.
 */
enum CommercialCollectionStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}
